# ===========================================
# APNA POS BACKEND ENVIRONMENT CONFIGURATION
# ===========================================

# Server & Database Settings
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/apna_pos
CLIENT_URL=*

# JWT Auth Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===========================================
# RAZORPAY PAYMENT GATEWAY SETTINGS
# ===========================================

# Mode Switch: set to 'test' or 'live'
RAZORPAY_MODE=test

# --- OPTION A: TEST CREDENTIALS (For Testing with fake money) ---
RAZORPAY_TEST_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_TEST_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_TEST_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- OPTION B: PRODUCTION / LIVE CREDENTIALS (For Real Payments) ---
RAZORPAY_LIVE_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_LIVE_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_LIVE_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- OPTIONAL SINGLE OVERRIDE (If set, used directly) ---
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ===========================================
# CLOUDFLARE R2 BUCKET STORAGE SETTINGS
# ===========================================
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=apna-pos-media
R2_PUBLIC_DOMAIN=https://pub-xxxxxxxxxxxxxxxx.r2.dev

# ===========================================
# GOOGLE GEMINI AI CONFIGURATION (Chotu AI Voice)
# ===========================================
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Python order automation (requires Python 3.11+; false disables Chotu execution)
CHOTU_AGENT_ENABLED=true
# Optional executable path; defaults to python on Windows, python3 elsewhere.
# CHOTU_PYTHON_BIN=C:/Python311/python.exe

# Facebook Login for Business / WhatsApp Embedded Signup
META_APP_ID=3643190475832679
META_EMBEDDED_SIGNUP_CONFIG_ID=1659729462561672
META_APP_SECRET=
# Set to the public HTTPS backend origin. Render supplies RENDER_EXTERNAL_URL.
META_PUBLIC_BASE_URL=
# For a multi-partner solution, enter the Solution ID from Meta.
META_PARTNER_SOLUTION_ID=
