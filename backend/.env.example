# ===========================================
# APNA POS BACKEND ENVIRONMENT CONFIGURATION
# ===========================================

# Server & Database Settings
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/apna_pos
CLIENT_URL=*

# JWT Auth Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===========================================
# RAZORPAY PAYMENT GATEWAY SETTINGS
# ===========================================

# Mode Switch: set to 'test' or 'live'
RAZORPAY_MODE=test

# --- OPTION A: TEST CREDENTIALS (For Testing with fake money) ---
RAZORPAY_TEST_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_TEST_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_TEST_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- OPTION B: PRODUCTION / LIVE CREDENTIALS (For Real Payments) ---
RAZORPAY_LIVE_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_LIVE_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_LIVE_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- OPTIONAL SINGLE OVERRIDE (If set, used directly) ---
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
